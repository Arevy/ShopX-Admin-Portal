# Only this application starts here. API and Redis are external dependencies.
# Use a reachable backend implementing the ShopX GraphQL contract.
GRAPHQL_UPSTREAM_ENDPOINT=http://host.docker.internal:4000/graphql
REDIS_URL=redis://host.docker.internal:6379/1
SERVER_SERVICES_TOKEN=replace-with-random-private-secret
# Product image origin must be reachable by both the browser and Next.js.
# For remote APIs, use their public hostname; for local APIs, use a reachable LAN hostname/IP.
SHOPX_PUBLIC_API_ORIGIN=http://your-backend-host:4000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3100

# Override host ports when another stack already occupies the defaults.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
